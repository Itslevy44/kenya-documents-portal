APP_NAME="Kenya Docs"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://kenyadocuments.online

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kenya_docs
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Africa's Talking (SMS OTP)
AT_USERNAME=your_at_username
AT_API_KEY=your_at_api_key
AT_SENDER_ID=KenyaDocs

# PayHero (M-Pesa STK Push — till number channel)
PAYHERO_API_USERNAME=your_payhero_username
PAYHERO_API_PASSWORD=your_payhero_password
PAYHERO_BASIC_AUTH=Basic_your_base64_token
PAYHERO_CHANNEL_ID=your_channel_id
PAYHERO_ACCOUNT_ID=your_account_id
PAYHERO_WEBHOOK_SECRET=your_webhook_secret

# Telegram Bot (Document Library Storage)
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHANNEL_ID=-100your_channel_id

# Admin
ADMIN_PHONE=07XXXXXXXX
