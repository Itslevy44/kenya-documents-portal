APP_NAME="Kenya Docs"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://yourdomain.infinityfreeapp.com

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kenya_docs
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Africa's Talking (SMS OTP)
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=KenyaDocs

# PayHero (M-Pesa STK Push)
PAYHERO_API_KEY=
PAYHERO_CHANNEL_ID=
PAYHERO_WEBHOOK_SECRET=

# Telegram Notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
